{
  "version": 5,
  "configurePresets": [
    {
      "name": "mingw-debug",
      "displayName": "MinGW + Ninja (Debug)",
      "description": "Qt se toma de la variable de entorno QT_ROOT_DIR (p. ej. C:/Qt/6.9.3/mingw_64); si no está definida, CMake busca Qt en las rutas del sistema. Para fijar una ruta local sin tocar este archivo, use CMakeUserPresets.json (ignorado por git).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW + Ninja (Release)",
      "description": "Variante optimizada de mingw-debug.",
      "inherits": "mingw-debug",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "configurePreset": "mingw-debug"
    },
    {
      "name": "rebuild-debug",
      "description": "Reconstrucción completa (limpia antes de compilar).",
      "configurePreset": "mingw-debug",
      "cleanFirst": true
    },
    {
      "name": "build-release",
      "configurePreset": "mingw-release"
    }
  ]
}
